[configuration]
entry_symbol = "godotsteam_init"
; Required by Godot >= 4.2. This file shipped without it, which made the
; extension fail to load with:
;   ERROR: GDExtension configuration file must contain a
;          "configuration/compatibility_minimum" key
compatibility_minimum = "4.2"

[libraries]
; Trimmed to the platforms this project ships binaries for. The original file
; also listed macOS/Linux entries, but the repo has no matching .dylib/.so
; builds that load on modern Godot.
windows.debug.x86_64 = "res://addons/godotsteam/win64/godotsteam.debug.dll"
windows.release.x86_64 = "res://addons/godotsteam/win64/godotsteam.dll"

[icons]
Steam = "res://addons/godotsteam/icon.png"
